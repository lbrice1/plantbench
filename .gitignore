# Environment
.venv/
__pycache__/
*.pyc
.DS_Store

# Generated datasets.  Each is regenerated from the specification committed beside its
# study; see README.md.
data/

# Caches and arrays the studies write, regenerated by the scripts that read them:
# cache/designs.pkl (studies.reactor_separator_recycle.designs), studies/*/results/analysis.npz.
cache/
*.pkl
*.npz

# Figures drawn by the study scripts.
figures/

# Packaging
*.egg-info/
build/
dist/

# Documentation build; docs/apidocs is written by sphinx-autodoc2 on every build.
docs/_build/
docs/apidocs/

# Tool caches
.pytest_cache/
.ruff_cache/

# pixi environments
.pixi/
